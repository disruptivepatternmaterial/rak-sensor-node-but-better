.DS_Store
.idea/
.vscode/
*.code-workspace
*.env
secrets.h
secrets.hpp
.pio/
.vscode/.browse.c_cpp.db*
compile_commands.json
*.pem
*.key
.particle_env.yaml

# Soak captures — generated evidence, sometimes hundreds of MB of serial log. The
# measured result belongs in docs/EVIDENCE.md; the transcript stays on the build host.
soak-runs/

# Build artifacts — rebuilt from source, never committed
*.uf2
*.hex
*.bin
*.elf
*.map

# Generated documentation — rebuilt from Markdown
docs/*.pdf
docs/img/

# Tooling
__pycache__/
*.pyc
.fwm/

# Raw bench captures. Summaries and verdicts belong in docs/EVIDENCE.md;
# multi-megabyte serial logs and scope traces do not belong in git.
evidence/raw/
*.log

# Scratch serial-capture helper, recreated per session
scripts/_serial_capture.py
